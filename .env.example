# Non-secret settings. Copy to .env and fill in.
# The Discord token and MausBot API key come from Keychain, never from here.

DISCORD_OWNER_ID=
DISCORD_GUILD_ALLOWLIST=
DISCORD_CHANNEL_ALLOWLIST=
DISCORD_AUTHOR_ALLOWLIST=
DISCORD_DM_ALLOWLIST=
REQUIRE_BOT_MENTION=true
BRAIN_MODE=mausbot

# Paste the full messages URL shown in MausBot's Bot API settings.
MAUSBOT_API_BASE=
MAUSBOT_ACTS_AS_ME=true

MAX_INFLIGHT_PER_CHANNEL=1
DEDUPE_TTL_SECONDS=600
RATE_LIMIT_PER_USER=8
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
