# Non-secret settings. Copy to .env and fill in.
# The Discord token and MausBot API key come from Keychain, never from here.

DISCORD_OWNER_ID=
DISCORD_GUILD_ALLOWLIST=
DISCORD_CHANNEL_ALLOWLIST=
DISCORD_AUTHOR_ALLOWLIST=
DISCORD_DM_ALLOWLIST=
REQUIRE_BOT_MENTION=true
BRAIN_MODE=mausbot

# Peer bots allowed to wake the bridge. Author allowlist = owner + these ids.
DISCORD_PEER_AUTHOR_ALLOWLIST=
# Ids that may receive a real <@id> ping from a reply. Others become @user:<id>.
DISCORD_MENTION_ALLOWLIST=

# Paste the full messages URL shown in MausBot's Bot API settings.
MAUSBOT_API_BASE=
MAUSBOT_ACTS_AS_ME=true

# Discord shows "is typing" for only a few seconds; refresh during long turns.
TYPING_PULSE_MS=5000

# If a turn outlasts the foreground wait window, keep polling this long (ms) and
# post the real reply to Discord when it arrives. 60000-3600000.
MAUSBOT_LATE_REPLY_MS=900000

# Optional loopback send API. The secret itself lives in Keychain as
# MAUSBOT_SEND_API_SECRET; with no secret the endpoint is not started.
SEND_API_PORT=8812

MAX_INFLIGHT_PER_CHANNEL=1
DEDUPE_TTL_SECONDS=600
RATE_LIMIT_PER_USER=8
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
